<?xml version="1.0" encoding="utf-8"?>
<StarAgent>
  <!--调试开关。默认true-->
  <Debug>true</Debug>
  <!--证书-->
  <Code></Code>
  <!--密钥-->
  <Secret></Secret>
  <!--项目名。新节点默认所需要加入的项目-->
  <Project></Project>
  <!--本地端口。默认5500-->
  <LocalPort>5500</LocalPort>
  <!--更新通道。默认Release-->
  <Channel>Release</Channel>
  <!--Windows自启动。自启动需要用户登录桌面，默认false使用系统服务-->
  <UseAutorun>false</UseAutorun>
  <!--用户名称。用户模式存储，服务模式读取-->
  <UserName>13971</UserName>
  <!--像素点。例如96*96。用户模式存储，服务模式读取-->
  <Dpi>288*288</Dpi>
  <!--分辨率。例如1024*768。用户模式存储，服务模式读取-->
  <Resolution>1920*1080</Resolution>
  <!--延迟时间。重启进程或服务的延迟时间，默认3000ms-->
  <Delay>3000</Delay>
  <!--同步时间间隔。定期同步服务器时间到本地，默认0秒不同步-->
  <SyncTime>0</SyncTime>
  <!--启动挂钩。拉起目标进程时，对dotNet应用注入星尘监控钩子，默认false-->
  <StartupHook>false</StartupHook>
  <!--应用服务集合-->
  <Services>
    <ServiceInfo Name="test" FileName="ping" Arguments="newlifex.com" WorkingDirectory="" UserName="" Enable="false" Mode="Default" AllowMultiple="false" Environments="" AutoStop="false" ReloadOnChange="false" MaxMemory="0" Priority="Normal" HealthCheck="" />
    <ServiceInfo Name="test2" FileName="cube.zip" Arguments="urls=http://*:1080" WorkingDirectory="../sso/web/" UserName="" Enable="false" Mode="Default" AllowMultiple="false" Environments="" AutoStop="false" ReloadOnChange="false" MaxMemory="0" Priority="Normal" HealthCheck="" />
    <ServiceInfo Name="StarServer" FileName="StarServer.zip" Arguments="StarServer.dll" WorkingDirectory="../star/server" UserName="" Enable="false" Mode="Default" AllowMultiple="false" Environments="" AutoStop="false" ReloadOnChange="false" MaxMemory="0" Priority="Normal" HealthCheck="" />
    <ServiceInfo Name="StarWeb" FileName="StarWeb.zip" Arguments="urls=http://*:6680" WorkingDirectory="../star/web" UserName="" Enable="false" Mode="Default" AllowMultiple="false" Environments="" AutoStop="false" ReloadOnChange="false" MaxMemory="0" Priority="Normal" HealthCheck="" />
  </Services>
</StarAgent>