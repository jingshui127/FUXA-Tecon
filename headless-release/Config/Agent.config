<?xml version="1.0" encoding="utf-8"?>
<Agent>
  <!--服务名-->
  <ServiceName>StarAgent</ServiceName>
  <!--显示名-->
  <DisplayName>进程守护</DisplayName>
  <!--服务描述-->
  <Description>持续监控你的应用，如果应用崩溃、卡顿或停止，会自动重启。它非常适合让非服务应用在后台运行，并确保它们在系统启动时自动启动，甚至在登录前就启动，无需重写为服务。QQ:2492123056</Description>
  <!--使用自动运行。在Windows系统上，自动运行是登录后在桌面运行，而不使用后台服务。默认false-->
  <UseAutorun>false</UseAutorun>
  <!--服务管理线程资源监控时间间隔。多久检测一次服务资源占用情况。默认10秒-->
  <WatchInterval>10</WatchInterval>
  <!--释放内存间隔。定时执行GC回收以及释放虚拟内存。默认600秒-->
  <FreeMemoryInterval>600</FreeMemoryInterval>
  <!--最大占用内存。超过最大占用时，整个服务进程将会重启，以释放资源。默认0M-->
  <MaxMemory>0</MaxMemory>
  <!--最大线程数。超过最大占用时，整个服务进程将会重启，以释放资源。默认1000个-->
  <MaxThread>1000</MaxThread>
  <!--最大句柄数。超过最大占用时，整个服务进程将会重启，以释放资源。默认10000个-->
  <MaxHandle>10000</MaxHandle>
  <!--自动重启时间。到达自动重启时间时，整个服务进程将会重启，以释放资源。默认0分，表示无限-->
  <AutoRestart>0</AutoRestart>
  <!--自动重启时间的范围。限制服务进程只能在这个时间范围内重启，格式为：00:00-06:00。默认为空，表示不限-->
  <RestartTimeRange></RestartTimeRange>
  <!--看门狗，保护其它服务，每分钟检查一次。多个服务名逗号分隔-->
  <WatchDog></WatchDog>
  <!--启动后命令，服务启动后执行的命令-->
  <AfterStart></AfterStart>
</Agent>