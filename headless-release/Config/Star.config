<?xml version="1.0" encoding="utf-8"?>
<Star>
  <!--调试开关。默认false-->
  <Debug>false</Debug>
  <!--星尘服务端地址。如http://star.newlifex.com:6600，默认为空-->
  <Server>http://47.113.219.65:6600</Server>
  <!--应用标识。接入星尘注册中心，英文名-->
  <AppKey>StarAgent</AppKey>
  <!--应用密钥。接入星尘注册中心-->
  <Secret>yqZistYZSrodirDo</Secret>
  <!--服务地址。用户访问的原始外网地址，用于内部构造其它Url，多地址逗号隔开，根据用户访问频率取前5-->
  <ServiceAddress></ServiceAddress>
  <!--允许的主机。多个主机名逗号隔开，支持*模糊匹配，用于验证请求的Host头，IP地址请求不进行验证。留空则不校验-->
  <AllowedHosts></AllowedHosts>
  <!--跟踪采样周期。定期上报埋点数据到星尘平台，默认60s-->
  <TracerPeriod>60</TracerPeriod>
  <!--最大正常采样数。采样周期内，最多只记录指定数量的正常事件，用于绘制依赖关系，默认1-->
  <MaxSamples>1</MaxSamples>
  <!--最大异常采样数。采样周期内，最多只记录指定数量的异常事件，默认10-->
  <MaxErrors>10</MaxErrors>
</Star>