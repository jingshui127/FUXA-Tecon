<?xml version="1.0" encoding="utf-8"?>
<Agent>
  <!--Service name-->
  <ServiceName>StarAgent</ServiceName>
  <!--Display name-->
  <DisplayName>进程守护</DisplayName>
  <!--Service description-->
  <Description>持续监控你的应用，如果应用崩溃、卡顿或停止，会自动重启。它非常适合让非服务应用在后台运行，并确保它们在系统启动时自动启动，甚至在登录前就启动，无需重写为服务。QQ:2492123056</Description>
  <!--Use autorun. On Windows, autorun starts on the desktop after login instead of running as a background service. Default false.-->
  <UseAutorun>false</UseAutorun>
  <!--Watch interval. Resource usage check period in seconds. Default 10.-->
  <WatchInterval>10</WatchInterval>
  <!--Free memory interval. Periodically run GC and release virtual memory, in seconds. Default 600.-->
  <FreeMemoryInterval>600</FreeMemoryInterval>
  <!--Max memory. Restart the process when usage exceeds this value to release resources. Default 0 means unlimited.-->
  <MaxMemory>0</MaxMemory>
  <!--Max thread count. Restart the process when the thread count exceeds this value to release resources. Default 1000.-->
  <MaxThread>1000</MaxThread>
  <!--Max handle count. Restart the process when the handle count exceeds this value to release resources. Default 10000.-->
  <MaxHandle>10000</MaxHandle>
  <!--Auto restart. Automatically restart the process when this interval is reached, in minutes. Default 0 means unlimited.-->
  <AutoRestart>0</AutoRestart>
  <!--Auto restart time range. Restrict restarts to this time window, format 00:00-06:00. Default unlimited.-->
  <RestartTimeRange></RestartTimeRange>
  <!--Watchdog. Protect other services and check every minute. Separate multiple service names with commas.-->
  <WatchDog></WatchDog>
  <!--After start. Command to run after the service starts.-->
  <AfterStart></AfterStart>
  <!--Enable the web management panel. Default true.-->
  <EnableWebPanel>true</EnableWebPanel>
  <!--Web management panel port. Default 5580.-->
  <WebPort>5500</WebPort>
  <!--Web panel bind address. Default 127.0.0.1 for local access only; set to * to listen on all interfaces, or specify an IP address.-->
  <WebBind>127.0.0.1</WebBind>
  <!--Web panel authentication level. None: no authentication; LocalOnly: local requests bypass authentication; Full: always authenticate. Default LocalOnly.-->
  <WebAuthLevel>LocalOnly</WebAuthLevel>
  <!--Web panel user name.-->
  <WebUserName>admin</WebUserName>
  <!--Web panel password.-->
  <WebPassword>admin</WebPassword>
</Agent>