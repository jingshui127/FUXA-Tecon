<?xml version="1.0" encoding="utf-8"?>
<Star>
  <!--Debug switch. Default false-->
  <Debug>false</Debug>
  <!--UI language, for example zh-Hans, zh-Hant, en, or ja; leave empty to follow the system language-->
  <Language></Language>
  <!--Disable strict SSH host key checking. Default false (checking enabled)-->
  <DisableSshStrictChecking>false</DisableSshStrictChecking>
  <!--Stardust server address. For example http://star.newlifex.com:6600; empty by default-->
  <Server>http://47.113.219.65:6600</Server>
  <!--App key. English name used to register with the Stardust registry-->
  <AppKey>StarAgent</AppKey>
  <!--App secret. Used to register with the Stardust registry-->
  <Secret>yqZistYZSrodirDo</Secret>
  <!--Service address. Public addresses used to build other URLs; separate multiple addresses with commas and the top 5 by request frequency are used-->
  <ServiceAddress></ServiceAddress>
  <!--Allowed hosts. Comma-separated host names with * wildcards, used to validate the Host header; IP requests are not validated. Leave empty to disable validation-->
  <AllowedHosts></AllowedHosts>
  <!--Trace sampling period. Interval for reporting trace data to Stardust, default 60s-->
  <TracerPeriod>60</TracerPeriod>
  <!--Maximum normal samples. Maximum normal events recorded per period for dependency graphs, default 1-->
  <MaxSamples>1</MaxSamples>
  <!--Maximum error samples. Maximum error events recorded per period, default 10-->
  <MaxErrors>10</MaxErrors>
  <!--Collect OpenTelemetry traces. Converts third-party component activities into traces, default true-->
  <EnableOpenTelemetry>true</EnableOpenTelemetry>
  <!--Trace name prefixes. Variable URL path segments are detected automatically; separate prefixes with semicolons and adjust manually if needed-->
  <TraceNamePrefixes></TraceNamePrefixes>
</Star>